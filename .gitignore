# macOS
.DS_Store

# Xcode — build products and per-user state
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.xcscmblueprint
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcresult
*.xcarchive
*.xcactivitylog

# Swift Package Manager
.build/
.swiftpm/

# Editor-local settings
.idea/
.vscode/
*.swp
*.swo

# CocoaPods / Carthage, if they ever appear
Pods/
Carthage/Build/

# Cloudflare Worker (the copy proxy)
worker/node_modules/
worker/.wrangler/
worker/dist/
worker/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ASO screenshot tooling — a standalone Next.js app, not FeelGood source
app-store-screenshots-editor/node_modules/
app-store-screenshots-editor/.next/

# Secrets — the Anthropic/Gemini keys live in the Cloudflare Worker, never here
*.xcconfig.local
.env
.env.*
!.env.example
worker/.dev.vars
worker/.dev.vars.*

# Claude Code tooling — skills cache and worktrees, not app content
.agents/
.claude/
skills-lock.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
